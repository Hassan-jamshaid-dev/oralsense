# Copy to backend/.env and fill in real values. Never commit backend/.env.

# PostgreSQL connection (psycopg 3 driver). Create the "oralsense" database first.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/oralsense

ENVIRONMENT=development

# Server-side session lifetime in hours.
SESSION_TTL_HOURS=12

# Set to true when serving over HTTPS so the session cookie is only sent over TLS.
# ENVIRONMENT=production always forces the Secure flag, even if this is false.
COOKIE_SECURE=false

# Comma-separated list of allowed browser origins (the frontend dev server by default).
# Never set this to *. Credentialed cookies require explicit origins.
# Mutating requests must send Origin matching this list (or the request host).
# Include every frontend origin you actually open in the browser (host + port).
# Local Vite often uses 5173; this repo also uses 5180. Keep production lists explicit.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,http://127.0.0.1:5180

# Unset: account creation is on in development and off in production.
# Set true or false to override that default.
# ALLOW_REGISTRATION=true

# Host header allow-list. Include the API hostname. testserver is for pytest.
# Never set to * in production. localhost stays in the default so local uvicorn works.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Trust X-Forwarded-Proto and X-Forwarded-For only from the IPs below. Leave false
# unless a reverse proxy you control sits in front of uvicorn. Host is not taken
# from X-Forwarded-Host. The app does not terminate TLS.
TRUST_FORWARDING=false
TRUSTED_PROXY_IPS=127.0.0.1

# Server-side only. Never put this in frontend env (no VITE_*), README, docs, or commits.
# Leave empty until you supply a key on the API host. An empty value keeps AI review unavailable.
OPENAI_API_KEY=
